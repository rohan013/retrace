# Copy to .env and fill in. .env is gitignored — never commit it.

# Shared secret the phone sends. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
INGEST_TOKEN=replace-me

HOST=127.0.0.1
PORT=8420
DB_PATH=data/tracker.db

# The hostname the tunnel routes here, subdomain or not. Requests
# arriving under any other name are refused, which is what stops a page that
# resolves its own hostname to 127.0.0.1 from reading the API out of a browser
# running on this machine. localhost and 127.0.0.1 are always allowed, so
# anything addressing the service locally works. Leave empty to disable the
# check.
PUBLIC_HOSTNAME=

# --- Segmentation thresholds -------------------------------------------------
# Tune these against your own real movement, then POST /api/v1/reprocess.

# A stay is points staying within this radius of their running centroid.
STAY_RADIUS_M=70
# Hard cap on drift from the stay's FIRST point, as a multiple of STAY_RADIUS_M.
# Stops a running centroid being dragged along by a slow walker.
STAY_DRIFT_CAP=1.5
# Minimum dwell before a cluster counts as a stay.
STAY_MIN_SECONDS=300
# Beyond this much silence, consult displacement before continuing a stay.
GAP_MAX_SECONDS=3600
# After a gap, if the next fix is within this distance the stay continues
# (phone was stationary and stopped reporting) rather than being split.
GAP_RESUME_DISTANCE_M=100
# ...but only up to this much silence. An overnight gap at home is plausibly one
# stay; three days of silence is not, however little the phone moved.
GAP_RESUME_MAX_SECONDS=43200
# Consecutive stays closer than this in time, at the same place, merge.
MERGE_GAP_SECONDS=900

# --- Quality flags -----------------------------------------------------------
# Accuracy is a WEIGHT, not a filter. Only absurd values are flagged.
ABSURD_ACCURACY_M=10000
NULL_ISLAND_RADIUS_M=5000
# Out-and-back detour speed above which a run of points is a stale-fix artefact.
MAX_DETOUR_SPEED_MPS=83

# --- Breakdown ----------------------------------------------------------------
# Minimum fixes per hour for a trip to count as movement in the day breakdown.
# Below it, the trip is a gap in the record rather than a journey and is reported
# as unknown location. Real journeys measure tens to hundreds of fixes an hour.
BREAKDOWN_TRIP_MIN_FIXES_PER_HOUR=4

# --- Alerts -------------------------------------------------------------------
# An executable that takes a message on stdin and delivers it. Leave empty and
# the freshness timer is not installed at all. Nothing about the channel is known
# to this repo -- no notification credentials live here.
ALERT_COMMAND=
# Which device's location to watch, as named in GET /api/v1/devices.
STALE_ALERT_DEVICE=
# Silence this long, with no fix from that device, sends one message. Raise it if
# short blips prove noisy.
STALE_ALERT_AFTER_MINUTES=10

# --- Places ------------------------------------------------------------------
PLACE_REUSE_RADIUS_M=50
# Reverse geocoding is off by default; it calls a public service with your
# coordinates. Enable deliberately.
GEOCODING_ENABLED=false
GEOCODER_USER_AGENT=retrace

# --- WHOOP --------------------------------------------------------------------
# From registering an app at the WHOOP Developer Dashboard. See the WHOOP
# section in README.md.
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
