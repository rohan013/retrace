# Copy to .env and fill in. .env is gitignored -- never commit it.

# Same tunnel hostname and INGEST_TOKEN the phone uses.
SERVER_URL=https://<your-host>/api/v1/locations
INGEST_TOKEN=replace-me

# The retrace-macbook Cloudflare Service Token (see the server's README,
# "MacBook" section) -- Zero Trust > Access controls > Service credentials.
CF_ACCESS_CLIENT_ID=replace-me
CF_ACCESS_CLIENT_SECRET=replace-me

# Identifies this machine in the events table and the day view's device
# filter. Free text, no spaces.
DEVICE=macbook

# How often to check the active browser tab while a tracked browser is
# frontmost. No effect the rest of the time -- focus/session are pushed by
# real notifications, not polled.
POLL_INTERVAL_SECONDS=4

# Where the offline retry queue is written if a POST fails.
QUEUE_PATH=queue.jsonl

# Comma-separated domains (subdomains match too) to restrict `site` reporting
# to. Leave empty to report every domain, as on the primary MacBook.
TRACKED_SITES=

# false stops `focus` (which app is frontmost) from ever being sent, while
# the same frontmost-app signal is still used internally to know when a
# tracked browser is in front and start/stop site polling. Pair with
# TRACKED_SITES on a machine that should only ever report site-level activity
# for specific domains, e.g. a work computer.
EMIT_FOCUS_EVENTS=true
