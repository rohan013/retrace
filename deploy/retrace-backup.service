[Unit]
Description=Back up the retrace database
Documentation=file:///home/rohan/tracker/README.md
OnFailure=retrace-alert@%n.service

[Service]
Type=oneshot
User=rohan
Group=rohan
ExecStart=/home/rohan/tracker/.venv/bin/python /home/rohan/tracker/scripts/backup.py

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/rohan/tracker/data
ProtectKernelTunables=yes
ProtectKernelModules=yes
RestrictSUIDSGID=yes
UMask=0077
